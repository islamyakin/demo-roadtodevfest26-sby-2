apiVersion: 1

apps:
  # 1. Konfigurasi Grafana Assistant App (untuk mode Self-Managed / OSS)
  - type: grafana-assistant-app
    org_id: 1
    disabled: false
    jsonData:
      ossMode: true
      backendUrl: "${GF_ASSISTANT_BACKEND_URL}"
      instanceId: "${GF_ASSISTANT_INSTANCE_ID}"
      isAccessTokenSet: true
    secureJsonData:
      accessToken: "${GF_ASSISTANT_ACCESS_TOKEN}"

  # 2. Konfigurasi Grafana LLM App (untuk fitur AI dengan OpenAI / Ollama / Custom LLM)
  - type: grafana-llm-app
    org_id: 1
    disabled: false
    jsonData:
      provider: "${LLM_PROVIDER}"
      openAIUrl: "${OPENAI_API_URL}"
      openAIModel: "${OPENAI_MODEL}"
    secureJsonData:
      openAIKey: "${OPENAI_API_KEY}"
