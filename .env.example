# Konfigurasi Dasar Grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
# GF_SERVER_ROOT_URL=http://localhost:3000/   (default follows GRAFANA_PORT)

# Google Cloud project yang dipakai workshop (wajib untuk docker compose)
GCP_PROJECT_ID=your-project-id

# Path ADC (hasil gcloud auth application-default login). Default: $HOME/.config/gcloud/...
# Wajib diisi path absolut kalau compose jalan di dalam VM (colima + nerdctl: $HOME di sana = /root)
# GCP_ADC_FILE=/Users/<you>/.config/gcloud/application_default_credentials.json

# Grafana Assistant: hubungkan lewat UI (Plugins → Grafana Assistant → Connection → Connect to Grafana Cloud).
# Tidak perlu token di sini.
