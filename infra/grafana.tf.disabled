# DISABLED for now: Terraform only reads *.tf files, so nothing in here is applied.
# To enable the Grafana Cloud side again:
#   1. git mv grafana.tf.disabled grafana.tf
#   2. main.tf: add  grafana = { source = "grafana/grafana", version = ">= 3.0" }  to required_providers,
#      and "secretmanager", "cloudscheduler", "iamcredentials" to local.apis
#   3. terraform.tfvars: add grafana_url and grafana_token, then terraform init && terraform apply
#
# Grafana Cloud side: how your stack reads Google Cloud, plus the dashboard and alert rules.
#
#   "Google Cloud (PromQL)"  Prometheus data source -> Cloud Monitoring's PromQL API (the Assistant speaks PromQL).
#   "Google Cloud Logging"   Google's Cloud Logging plugin.
# Both authenticate with a short-lived access token of the read-only account grafana-reader. No keys:
# the organization forbids service-account keys (iam.disableServiceAccountKeyCreation), and keys are a
# liability anyway. The Cloud Run job "grafana-token-sync" (tokensync.py) renews the token every 10 min.

provider "grafana" {
  url  = var.grafana_url
  auth = var.grafana_token
}

# The read-only account google_service_account.grafana and its roles live in grafana-reader.tf.

# The job mints fresh 1-hour tokens for itself (generateAccessToken on its own account).
resource "google_service_account_iam_member" "grafana_self_token" {
  service_account_id = google_service_account.grafana.name
  role               = "roles/iam.serviceAccountTokenCreator"
  member             = "serviceAccount:${google_service_account.grafana.email}"
}

# ---------- Data sources (the token sync job fills in the auth part) ----------

resource "grafana_data_source" "promql" {
  type       = "prometheus"
  name       = "Google Cloud (PromQL)"
  uid        = "gcp-promql"
  is_default = true
  url        = "https://monitoring.googleapis.com/v1/projects/${var.project_id}/location/global/prometheus/"
  json_data_encoded = jsonencode({
    httpMethod   = "GET"
    timeInterval = "60s"
    manageAlerts = false # Cloud Monitoring has no rules API; the alert rules live in Grafana
  })                     # the Authorization header is set by the token sync job
  lifecycle { ignore_changes = [url, json_data_encoded, secure_json_data_encoded, http_headers] }
}

resource "grafana_data_source" "logging" {
  type = "googlecloud-logging-datasource" # install the plugin once in your stack first (README)
  name = "Google Cloud Logging"
  uid  = "gcp-logging"
  json_data_encoded = jsonencode({
    authenticationType = "accessToken"
    defaultProject     = var.project_id
  })
  lifecycle { ignore_changes = [json_data_encoded, secure_json_data_encoded] }
}

# ---------- Token sync: Cloud Run job, every 10 min ----------

resource "google_secret_manager_secret" "grafana_token" {
  secret_id = "grafana-sa-token"
  replication {
    auto {}
  }
  depends_on = [google_project_service.apis]
}

resource "google_secret_manager_secret_version" "grafana_token" {
  secret      = google_secret_manager_secret.grafana_token.id
  secret_data = var.grafana_token
}

resource "google_secret_manager_secret_iam_member" "token_sync" {
  secret_id = google_secret_manager_secret.grafana_token.id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.grafana.email}"
}

resource "google_cloud_run_v2_job" "token_sync" {
  name                = "grafana-token-sync"
  location            = var.region
  deletion_protection = false

  template {
    template {
      service_account = google_service_account.grafana.email
      max_retries     = 1
      timeout         = "120s"
      containers {
        image   = "python:3.12-slim" # Docker Hub: Cloud Run pulls it directly; the script needs only the stdlib
        command = ["python", "-c", file("${path.module}/tokensync.py")]
        env {
          name  = "PROJECT_ID"
          value = var.project_id
        }
        env {
          name  = "SA_EMAIL"
          value = google_service_account.grafana.email
        }
        env {
          name  = "GRAFANA_URL"
          value = var.grafana_url
        }
        env {
          name = "GRAFANA_TOKEN"
          value_source {
            secret_key_ref {
              secret  = google_secret_manager_secret.grafana_token.secret_id
              version = "latest"
            }
          }
        }
      }
    }
  }
  depends_on = [google_secret_manager_secret_version.grafana_token, google_secret_manager_secret_iam_member.token_sync]
}

resource "google_cloud_run_v2_job_iam_member" "scheduler" {
  name     = google_cloud_run_v2_job.token_sync.name
  location = var.region
  role     = "roles/run.invoker"
  member   = "serviceAccount:${google_service_account.grafana.email}"
}

resource "google_cloud_scheduler_job" "token_sync" {
  name     = "grafana-token-sync"
  region   = var.region
  schedule = "*/10 * * * *" # tokens live 1 h, renewed every 10 min
  http_target {
    http_method = "POST"
    uri         = "https://run.googleapis.com/v2/${google_cloud_run_v2_job.token_sync.id}:run"
    oauth_token {
      service_account_email = google_service_account.grafana.email
    }
  }
  depends_on = [google_cloud_run_v2_job_iam_member.scheduler]
}

# Run the job once now, so both data sources work before the first schedule tick.
resource "terraform_data" "first_sync" {
  triggers_replace = [google_cloud_run_v2_job.token_sync.id, grafana_data_source.promql.id, grafana_data_source.logging.id, google_secret_manager_secret_version.grafana_token.id]
  provisioner "local-exec" {
    command = "gcloud run jobs execute ${google_cloud_run_v2_job.token_sync.name} --region ${var.region} --project ${var.project_id} --wait"
  }
  depends_on = [google_project_iam_member.grafana, google_service_account_iam_member.grafana_self_token]
}

# Proof, not hope: apply fails unless Grafana itself reports both data sources healthy.
resource "terraform_data" "check_datasources" {
  triggers_replace = [terraform_data.first_sync.id]
  provisioner "local-exec" {
    environment = { GRAFANA_URL = var.grafana_url, GRAFANA_TOKEN = var.grafana_token }
    command     = <<-EOT
      for uid in gcp-promql gcp-logging; do
        r=$(printf 'Authorization: Bearer %s\n' "$GRAFANA_TOKEN" | curl -sS -H @- "$GRAFANA_URL/api/datasources/uid/$uid/health")
        echo "$uid: $r"
        echo "$r" | grep -q '"status": *"OK"' || { echo "data source $uid is NOT healthy"; exit 1; }
      done
    EOT
  }
}

# ---------- Dashboard + alert rules ----------

resource "grafana_folder" "workshop" {
  title = "Workshop"
  uid   = "workshop"
}

resource "grafana_dashboard" "shop" {
  folder      = grafana_folder.workshop.uid
  config_json = file("${path.module}/shop-overview.json")
  overwrite   = true
}

locals {
  run = "monitored_resource=\"cloud_run_revision\",service_name=~\"frontend|backend\""
  alerts = {
    "5xx ratio above 5%" = {
      expr      = "sum by (service_name) (rate(run_googleapis_com:request_count{${local.run},response_code_class=\"5xx\"}[5m])) / sum by (service_name) (rate(run_googleapis_com:request_count{${local.run}}[5m]))"
      threshold = 0.05
      summary   = "{{ $labels.service_name }}: more than 5% of requests fail with 5xx."
    }
    "p95 latency above 1s" = {
      expr      = "histogram_quantile(0.95, sum by (le, service_name) (rate(run_googleapis_com:request_latencies_bucket{${local.run}}[5m])))"
      threshold = 1000
      summary   = "{{ $labels.service_name }}: p95 latency is above 1000 ms."
    }
  }
}

# Symptom alerts on Cloud Run's built-in metrics, one instance per service. They say WHERE it hurts;
# the Assistant and you find WHY.
resource "grafana_rule_group" "shop" {
  name             = "shop"
  folder_uid       = grafana_folder.workshop.uid
  interval_seconds = 60

  dynamic "rule" {
    for_each = local.alerts
    content {
      name           = rule.key
      condition      = "C"
      for            = "2m"
      no_data_state  = "OK"
      exec_err_state = "Error"
      labels         = { severity = "page" }
      annotations    = { summary = rule.value.summary, runbook = "Ask Grafana Assistant: prompts/lab3-rca.md" }
      data {
        ref_id         = "A"
        datasource_uid = grafana_data_source.promql.uid
        relative_time_range {
          from = 600
          to   = 0
        }
        model = jsonencode({ refId = "A", instant = true, expr = rule.value.expr })
      }
      data {
        ref_id         = "C"
        datasource_uid = "__expr__"
        relative_time_range {
          from = 0
          to   = 0
        }
        model = jsonencode({
          refId      = "C", type = "threshold", expression = "A",
          conditions = [{ evaluator = { type = "gt", params = [rule.value.threshold] } }]
        })
      }
    }
  }
}

output "grafana_dashboard_url" { value = "${var.grafana_url}/d/${grafana_dashboard.shop.uid}" }

variable "grafana_url" {
  type        = string
  description = "Your Grafana Cloud stack, e.g. https://<stack>.grafana.net"
}

variable "grafana_token" {
  type        = string
  sensitive   = true
  description = "Token of a stack service account with role Admin (Administration > Users and access > Service accounts)"
}
